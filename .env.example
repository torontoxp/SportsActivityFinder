# ── Environment Variables ────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# When VITE_API_BASE_URL is NOT set, the app uses local mock data automatically.

# Your API Gateway base URL (no trailing slash)
# Example: https://abc123xyz.execute-api.ca-central-1.amazonaws.com/prod
VITE_API_BASE_URL=
